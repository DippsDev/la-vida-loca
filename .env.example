NUXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NUXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# Admin signs in on /admin/login with an Admin Username and Admin Pin.
# The first successful sign-in creates username@lavidaloca.com in Supabase Auth.
# Turn off Confirm email under Authentication → Providers → Email, or the
# account is saved but cannot sign in until it is confirmed.
# The PIN must be at least 6 characters.

# RSVP emails are sent by the Supabase Edge Function rsvp-mail.
# Set these as Edge Function secrets, not in this file:
# RESEND_API_KEY
# Until a domain is verified: RSVP_FROM_EMAIL=onboarding@resend.dev
# That is sent as La Vida Loca <onboarding@resend.dev>.
# After you own a domain: RSVP_FROM_EMAIL=La Vida Loca <rsvp@yourdomain.com>
# SITE_URL=https://your-site.example
# The acceptance email links to SITE_URL/status so the guest can open their ticket.